# Set these values in your local environment or hosting provider's secrets UI.
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Local-development backend port only
API_PORT=3001
